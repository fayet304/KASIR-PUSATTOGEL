<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aplikasi Kasir</title>
<style>
  :root{
    --bg:#f4f6f9; --card:#ffffff; --text:#1a1d29; --muted:#6b7280;
    --primary:#2563eb; --primary-dark:#1d4ed8; --green:#16a34a; --red:#dc2626;
    --border:#e5e7eb; --radius:14px;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);}
  .app{max-width:1100px;margin:0 auto;padding:16px;padding-bottom:90px;}
  .hidden{display:none !important;}

  /* LOGIN */
  .login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}
  .login-card{background:var(--card);border-radius:var(--radius);padding:32px 24px;width:100%;max-width:380px;box-shadow:0 4px 20px rgba(0,0,0,.08);}
  .login-card h1{font-size:22px;margin:0 0 24px;text-align:center;}
  input{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:10px;font-size:15px;margin-bottom:12px;}
  button{cursor:pointer;border:none;border-radius:10px;font-size:15px;font-weight:600;padding:12px 16px;}
  .btn-primary{background:var(--primary);color:#fff;width:100%;}
  .btn-primary:active{background:var(--primary-dark);}
  .link-reset{display:block;text-align:center;margin-top:14px;color:var(--primary);font-size:14px;text-decoration:none;}
  .error-msg{color:var(--red);font-size:13px;margin:-4px 0 10px;}

  /* NAV */
  .topbar{display:flex;justify-content:space-between;align-items:center;padding:10px 4px 18px;}
  .topbar h2{margin:0;font-size:18px;}
  .logout-btn{background:none;color:var(--red);font-weight:600;font-size:14px;padding:6px 10px;}
  .tabbar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);display:flex;justify-content:space-around;padding:8px 0;z-index:50;}
  .tabbar button{background:none;color:var(--muted);font-size:12px;flex:1;padding:8px 4px;font-weight:500;}
  .tabbar button.active{color:var(--primary);}

  /* DASHBOARD */
  .grid-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .card{background:var(--card);border-radius:var(--radius);padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.05);}
  .card .label{color:var(--muted);font-size:12px;margin-bottom:6px;}
  .card .value{font-size:20px;font-weight:700;}
  .card.wide{grid-column:1/-1;}
  .staff-chip{display:inline-block;background:#dcfce7;color:var(--green);font-size:12px;padding:4px 10px;border-radius:20px;margin:3px 4px 0 0;}
  .breakdown-row{display:flex;justify-content:space-between;font-size:14px;padding:6px 0;border-bottom:1px solid var(--border);}
  .breakdown-row:last-child{border-bottom:none;}

  /* TRANSAKSI */
  .rekening-select{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;margin-bottom:16px;}
  .rekening-chip{flex:0 0 auto;background:var(--card);border:2px solid var(--border);border-radius:12px;padding:12px 16px;min-width:140px;cursor:pointer;}
  .rekening-chip.active{border-color:var(--primary);background:#eff6ff;}
  .rekening-chip .rj{font-weight:700;font-size:14px;}
  .rekening-chip .rn{font-size:12px;color:var(--muted);}
  .rekening-chip .rs{font-size:14px;font-weight:600;margin-top:4px;color:var(--green);}

  .jenis-toggle{display:flex;gap:8px;margin-bottom:16px;}
  .jenis-toggle button{flex:1;background:#fff;border:2px solid var(--border);color:var(--text);}
  .jenis-toggle button.active{border-color:var(--primary);background:var(--primary);color:#fff;}

  .bank-pill-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
  .bank-pill{background:#fff;border:2px solid var(--border);padding:8px 16px;border-radius:20px;font-weight:600;font-size:13px;}
  .bank-pill.active{border-color:var(--primary);background:var(--primary);color:#fff;}

  .form-card{background:var(--card);border-radius:var(--radius);padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.05);}
  .form-card label{font-size:13px;color:var(--muted);display:block;margin-bottom:4px;}
  select{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:10px;font-size:15px;margin-bottom:12px;background:#fff;}
  .kas-menu{display:flex;flex-direction:column;gap:10px;margin-bottom:16px;}
  .kas-menu button{background:#fff;border:2px solid var(--border);text-align:left;padding:14px;color:var(--text);}
  .kas-menu button.active{border-color:var(--primary);background:#eff6ff;}
  .toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#111827;color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;z-index:100;}

  @media(min-width:700px){
    .grid-cards{grid-template-columns:1fr 1fr 1fr;}
    .tabbar{position:static;border:none;justify-content:flex-start;gap:20px;background:none;padding:0 0 20px;}
    .tabbar button{flex:none;font-size:14px;}
    .app{padding-bottom:24px;}
  }
</style>
</head>
<body>

<!-- ================= LOGIN VIEW ================= -->
<div id="view-login" class="login-wrap">
  <div class="login-card">
    <h1>🔐 Login Kasir</h1>
    <div id="login-error" class="error-msg hidden"></div>
    <label>User ID</label>
    <input id="input-userid" type="text" placeholder="User ID">
    <label>Sandi</label>
    <input id="input-password" type="password" placeholder="Sandi">
    <button class="btn-primary" onclick="doLogin()">Masuk</button>
    <a href="#" class="link-reset" onclick="resetSandi(event)">Lupa sandi? Hubungi CS</a>
  </div>
</div>

<!-- ================= MAIN APP ================= -->
<div id="view-app" class="app hidden">
  <div class="topbar">
    <h2 id="welcome-text">Halo</h2>
    <button class="logout-btn" onclick="logout()">Keluar</button>
  </div>

  <div class="tabbar">
    <button id="tab-dashboard" class="active" onclick="switchTab('dashboard')">📊 Dashboard</button>
    <button id="tab-transaksi" onclick="switchTab('transaksi')">💳 Transaksi</button>
  </div>

  <!-- DASHBOARD -->
  <div id="panel-dashboard">
    <div class="grid-cards">
      <div class="card wide">
        <div class="label">Staff Kasir Online</div>
        <div id="staff-online-list">Memuat...</div>
      </div>
      <div class="card">
        <div class="label">Saldo Masuk (Depo)</div>
        <div class="value" id="total-masuk">Rp 0</div>
      </div>
      <div class="card">
        <div class="label">Saldo Keluar (WD)</div>
        <div class="value" id="total-keluar">Rp 0</div>
      </div>
      <div class="card wide">
        <div class="label">Total Saldo Kas → Bank (Proses WD)</div>
        <div id="kas-ke-bank-list"></div>
      </div>
      <div class="card wide">
        <div class="label">Total Setor Saldo Bank Depo → Kas</div>
        <div class="value" id="total-setor">Rp 0</div>
      </div>
    </div>
  </div>

  <!-- TRANSAKSI -->
  <div id="panel-transaksi" class="hidden">
    <div class="rekening-select" id="rekening-select"></div>

    <div class="jenis-toggle">
      <button id="jenis-depo" onclick="pilihJenis('Depo')">Depo</button>
      <button id="jenis-wd" onclick="pilihJenis('WD')">WD</button>
      <button id="jenis-kas" onclick="pilihJenis('Kas')">Kas</button>
    </div>

    <!-- DEPO / WD FORM -->
    <div id="form-bank-wrap" class="hidden">
      <div class="bank-pill-row" id="bank-pill-row"></div>
      <div class="form-card">
        <form id="form-depo-wd" onsubmit="submitDepoWd(event)">
          <label>User ID</label>
          <input id="dw-userid" required>
          <div id="dw-depo-fields">
            <label>Nama Pengirim</label>
            <input id="dw-nama-pengirim">
          </div>
          <div id="dw-wd-fields" class="hidden">
            <label>Kirim Kemana</label>
            <input id="dw-kirim-kemana">
          </div>
          <label>Nominal</label>
          <input id="dw-nominal" type="number" required>
          <div id="dw-admin-fee-wrap">
            <label>Admin Fee</label>
            <input id="dw-admin-fee" type="number" value="0">
          </div>
          <button class="btn-primary" type="submit">Submit</button>
        </form>
      </div>
    </div>

    <!-- KAS MENU -->
    <div id="form-kas-wrap" class="hidden">
      <div class="kas-menu">
        <button id="kas-opt-pengajuan" onclick="pilihKasMenu('pengajuan')"><b>Pengajuan Saldo Kas</b><br><span style="font-size:12px;color:var(--muted)">Kas → Bank</span></button>
        <button id="kas-opt-setor" onclick="pilihKasMenu('setor')"><b>Setor Saldo</b><br><span style="font-size:12px;color:var(--muted)">Bank Depo → Kas</span></button>
      </div>

      <div id="form-kas-pengajuan" class="form-card hidden">
        <form onsubmit="submitKasPengajuan(event)">
          <label>Dari Kas Mana</label>
          <select id="kp-kas-asal"></select>
          <label>Bank Tujuan Saldo</label>
          <select id="kp-bank-tujuan"></select>
          <label>Nominal</label>
          <input id="kp-nominal" type="number" required>
          <button class="btn-primary" type="submit">Submit</button>
        </form>
      </div>

      <div id="form-kas-setor" class="form-card hidden">
        <form onsubmit="submitKasSetor(event)">
          <label>Dari Bank Depo Mana</label>
          <select id="ks-bank-asal"></select>
          <label>Ke Kas Mana</label>
          <select id="ks-kas-tujuan"></select>
          <label>Nominal</label>
          <input id="ks-nominal" type="number" required>
          <button class="btn-primary" type="submit">Submit</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// =====================================================================
// GANTI URL INI dengan URL Web App hasil deploy Google Apps Script kamu
// =====================================================================
const APPS_SCRIPT_URL = 'GANTI_DENGAN_URL_WEB_APP_APPS_SCRIPT';

let currentUser = null;
let rekeningData = [];
let selectedRekeningId = null;
let currentJenis = null;
let currentBank = null;
let heartbeatTimer = null;

async function callApi(action, payload={}) {
  const res = await fetch(APPS_SCRIPT_URL, {
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({action, payload})
  });
  return res.json();
}

function showToast(msg){
  const t = document.createElement('div');
  t.className='toast'; t.textContent=msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 2500);
}

function formatRp(n){
  return 'Rp ' + Number(n||0).toLocaleString('id-ID');
}

// ---------- LOGIN ----------
async function doLogin(){
  const user_id = document.getElementById('input-userid').value.trim();
  const password = document.getElementById('input-password').value;
  const errEl = document.getElementById('login-error');
  errEl.classList.add('hidden');
  if(!user_id || !password){ errEl.textContent='Isi User ID dan sandi'; errEl.classList.remove('hidden'); return; }

  const res = await callApi('login', {user_id, password});
  if(!res.success){ errEl.textContent = res.message || 'Login gagal'; errEl.classList.remove('hidden'); return; }

  currentUser = res;
  localStorage.setItem('kasir_user', JSON.stringify(res));
  enterApp();
}

function resetSandi(e){
  e.preventDefault();
  window.open('https://line.me/ti/p/GANTI_DENGAN_ID_LINE_CS', '_blank');
}

function logout(){
  clearInterval(heartbeatTimer);
  localStorage.removeItem('kasir_user');
  currentUser = null;
  document.getElementById('view-app').classList.add('hidden');
  document.getElementById('view-login').classList.remove('hidden');
}

function enterApp(){
  document.getElementById('view-login').classList.add('hidden');
  document.getElementById('view-app').classList.remove('hidden');
  document.getElementById('welcome-text').textContent = 'Halo, ' + currentUser.nama;
  startHeartbeat();
  loadRekening();
  switchTab('dashboard');
}

function startHeartbeat(){
  callApi('heartbeat', {user_id: currentUser.user_id});
  heartbeatTimer = setInterval(()=>callApi('heartbeat', {user_id: currentUser.user_id}), 60000);
}

// ---------- TAB SWITCH ----------
function switchTab(tab){
  document.getElementById('tab-dashboard').classList.toggle('active', tab==='dashboard');
  document.getElementById('tab-transaksi').classList.toggle('active', tab==='transaksi');
  document.getElementById('panel-dashboard').classList.toggle('hidden', tab!=='dashboard');
  document.getElementById('panel-transaksi').classList.toggle('hidden', tab!=='transaksi');
  if(tab==='dashboard') loadDashboard();
}

// ---------- DASHBOARD ----------
async function loadDashboard(){
  const res = await callApi('getDashboard');
  if(!res.success) return;
  document.getElementById('staff-online-list').innerHTML = res.staffOnline.length
    ? res.staffOnline.map(s=>`<span class="staff-chip">🟢 ${s.nama}</span>`).join('')
    : '<span style="color:var(--muted);font-size:13px">Tidak ada staff online</span>';
  document.getElementById('total-masuk').textContent = formatRp(res.totalMasuk);
  document.getElementById('total-keluar').textContent = formatRp(res.totalKeluar);
  document.getElementById('total-setor').textContent = formatRp(res.setorTotal);

  const kkb = res.kasKeBank || {};
  const keys = Object.keys(kkb);
  document.getElementById('kas-ke-bank-list').innerHTML = keys.length
    ? keys.map(k=>`<div class="breakdown-row"><span>${k}</span><b>${formatRp(kkb[k])}</b></div>`).join('')
    : '<span style="color:var(--muted);font-size:13px">Belum ada data</span>';
}

// ---------- REKENING ----------
async function loadRekening(){
  const res = await callApi('getRekening');
  if(!res.success) return;
  rekeningData = res.data;
  renderRekeningSelect();
  renderKasDropdowns();
}

function renderRekeningSelect(){
  const wrap = document.getElementById('rekening-select');
  wrap.innerHTML = rekeningData.filter(r=>r.tipe==='Bank').map(r=>`
    <div class="rekening-chip ${r.id===selectedRekeningId?'active':''}" onclick="pilihRekening('${r.id}')">
      <div class="rj">${r.jenis_bank}</div>
      <div class="rn">${r.nama_akun}</div>
      <div class="rs">${formatRp(r.saldo)}</div>
    </div>`).join('');
}

function pilihRekening(id){
  selectedRekeningId = id;
  currentBank = id;
  renderRekeningSelect();
}

function renderKasDropdowns(){
  const kasList = rekeningData.filter(r=>r.tipe==='Kas');
  const bankList = rekeningData.filter(r=>r.tipe==='Bank');
  const optKas = kasList.map(k=>`<option value="${k.id}">${k.nama_akun}</option>`).join('');
  const optBank = bankList.map(b=>`<option value="${b.id}">${b.jenis_bank} - ${b.nama_akun}</option>`).join('');
  document.getElementById('kp-kas-asal').innerHTML = optKas;
  document.getElementById('kp-bank-tujuan').innerHTML = optBank;
  document.getElementById('ks-bank-asal').innerHTML = optBank;
  document.getElementById('ks-kas-tujuan').innerHTML = optKas;
}

// ---------- JENIS: Depo / WD / Kas ----------
function pilihJenis(jenis){
  currentJenis = jenis;
  document.getElementById('jenis-depo').classList.toggle('active', jenis==='Depo');
  document.getElementById('jenis-wd').classList.toggle('active', jenis==='WD');
  document.getElementById('jenis-kas').classList.toggle('active', jenis==='Kas');

  document.getElementById('form-bank-wrap').classList.toggle('hidden', jenis==='Kas');
  document.getElementById('form-kas-wrap').classList.toggle('hidden', jenis!=='Kas');

  if(jenis==='Depo' || jenis==='WD'){
    document.getElementById('dw-depo-fields').classList.toggle('hidden', jenis!=='Depo');
    document.getElementById('dw-wd-fields').classList.toggle('hidden', jenis!=='WD');
    document.getElementById('dw-admin-fee-wrap').classList.toggle('hidden', jenis!=='Depo');
    renderBankPills();
  }
}

function renderBankPills(){
  const bankList = rekeningData.filter(r=>r.tipe==='Bank');
  document.getElementById('bank-pill-row').innerHTML = bankList.map(b=>`
    <div class="bank-pill ${b.id===selectedRekeningId?'active':''}" onclick="pilihRekening('${b.id}')">${b.jenis_bank}</div>
  `).join('');
}

function pilihKasMenu(menu){
  document.getElementById('kas-opt-pengajuan').classList.toggle('active', menu==='pengajuan');
  document.getElementById('kas-opt-setor').classList.toggle('active', menu==='setor');
  document.getElementById('form-kas-pengajuan').classList.toggle('hidden', menu!=='pengajuan');
  document.getElementById('form-kas-setor').classList.toggle('hidden', menu!=='setor');
}

// ---------- SUBMIT ----------
async function submitDepoWd(e){
  e.preventDefault();
  if(!selectedRekeningId){ showToast('Pilih bank dulu'); return; }
  const nominal = document.getElementById('dw-nominal').value;
  const payload = {
    tipe: currentJenis,
    user_id: document.getElementById('dw-userid').value,
    nominal,
    nama_pihak: currentJenis==='Depo' ? document.getElementById('dw-nama-pengirim').value : document.getElementById('dw-kirim-kemana').value,
    admin_fee: currentJenis==='Depo' ? document.getElementById('dw-admin-fee').value : 0
  };
  if(currentJenis==='Depo') payload.rekening_tujuan = selectedRekeningId;
  if(currentJenis==='WD') payload.rekening_asal = selectedRekeningId;

  const res = await callApi('submitTransaksi', payload);
  if(res.success){ showToast('Transaksi berhasil disimpan'); document.getElementById('form-depo-wd').reset(); loadRekening(); }
  else showToast(res.message || 'Gagal menyimpan');
}

async function submitKasPengajuan(e){
  e.preventDefault();
  const payload = {
    tipe:'PengajuanKas',
    user_id: currentUser.user_id,
    rekening_asal: document.getElementById('kp-kas-asal').value,
    rekening_tujuan: document.getElementById('kp-bank-tujuan').value,
    nominal: document.getElementById('kp-nominal').value
  };
  const res = await callApi('submitTransaksi', payload);
  if(res.success){ showToast('Pengajuan kas berhasil'); e.target.reset(); loadRekening(); }
  else showToast(res.message || 'Gagal menyimpan');
}

async function submitKasSetor(e){
  e.preventDefault();
  const payload = {
    tipe:'SetorKas',
    user_id: currentUser.user_id,
    rekening_asal: document.getElementById('ks-bank-asal').value,
    rekening_tujuan: document.getElementById('ks-kas-tujuan').value,
    nominal: document.getElementById('ks-nominal').value
  };
  const res = await callApi('submitTransaksi', payload);
  if(res.success){ showToast('Setor saldo berhasil'); e.target.reset(); loadRekening(); }
  else showToast(res.message || 'Gagal menyimpan');
}

// ---------- INIT: cek sesi tersimpan ----------
window.onload = function(){
  const saved = localStorage.getItem('kasir_user');
  if(saved){ currentUser = JSON.parse(saved); enterApp(); }
};
</script>
</body>
</html>
